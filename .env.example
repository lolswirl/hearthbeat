# Discord (https://discord.com/developers/applications)
DISCORD_TOKEN=
CHANNEL_ID=
# Optional: set to register /status instantly in one server (global commands can take up to an hour)
GUILD_ID=

# Blizzard API client (https://develop.battle.net/access/clients)
BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=

# us | eu | kr | tw
REGION=us

# How often to check realm status, in seconds
POLL_SECONDS=60

# Realm slugs that get their own up/down messages (comma separated). Leave empty for region-wide messages only.
WATCH_REALMS=area-52,illidan,stormrage

# A region-wide message is posted when at least this fraction of realms are down (maintenance / outage)
MASS_CHANGE_THRESHOLD=0.5

# Weekly maintenance warning. Defaults are US (Tuesday 07:00 Pacific).
# EU example: MAINT_DAY=3 MAINT_HOUR=4 MAINT_TZ=Europe/Paris
MAINT_DAY=2
MAINT_HOUR=7
MAINT_TZ=America/Los_Angeles
# Minutes before maintenance to post warnings (comma separated). Empty disables.
MAINT_WARN_MINUTES=60,15

# Optional: role to ping on alerts (role ID)
PING_ROLE_ID=
